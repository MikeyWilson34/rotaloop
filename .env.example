# Copy to .env and fill in from your hosted Supabase project:
#   Supabase dashboard > Project Settings > API
# EXPO_PUBLIC_* values are bundled into the app and visible to users.
# Only ever put the public anon key here, never the service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Where the web app is hosted. Invite links and QR codes point here: <url>/join/<token>.
# Optional: defaults to https://rotaloop.expo.app (see src/config/app.ts).
EXPO_PUBLIC_WEB_URL=https://rotaloop.expo.app
