{
  "name": "rotaloop",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web && tsx scripts/web-postexport.ts",
    "deploy:web:preview": "npm run web:export && npx -y eas-cli deploy --non-interactive",
    "deploy:web": "npm run web:export && npx -y eas-cli deploy --prod --non-interactive",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:nav": "node scripts/e2e-nav.mjs",
    "typegen": "expo customize tsconfig.json",
    "typecheck": "npm run typegen && tsc --noEmit",
    "lint": "expo lint",
    "functions:sync": "node scripts/sync-functions-shared.mjs",
    "functions:check": "npm run functions:sync && npx -y deno check --no-lock supabase/functions/group-command/index.ts supabase/functions/notify/index.ts",
    "functions:deploy": "npm run functions:sync && npx supabase functions deploy group-command && npx supabase functions deploy notify",
    "db:push": "npx supabase db push --remote",
    "db:types": "npx supabase gen types typescript --project-id pyeobqbwlvqsukmuaxkb --schema public > src/lib/database.types.ts"
  },
  "dependencies": {
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.25",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "lucide-react-native": "^1.73.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-qrcode-svg": "^6.3.54",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "playwright-core": "^1.49.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
